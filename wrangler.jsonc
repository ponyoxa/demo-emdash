{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "demo-emdash",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "demo-emdash",
			// Run `wrangler d1 create my-emdash-site` and paste the real ID here for deploy
			"database_id": "959f1c75-db0b-45e4-9011-c45568117f44",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "demo-emdash","preview_bucket_name": "demo-emdash",
		},
	],
	// Worker Loader for plugin sandboxing
	// "worker_loaders": [
	// 	{
	// 		"binding": "LOADER",
	// 	},
	// ],
}
